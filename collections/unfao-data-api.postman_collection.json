{
  "item": [
    {
      "id": "903fd20c-eb0c-41bc-917c-9ee6cb8b14af",
      "name": "Data",
      "description": {
        "content": "Operations for retrieving FAOSTAT statistical data",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4513cf2e-e055-4e87-bd7d-ca76a0262562",
          "name": "Query data from a FAOSTAT domain",
          "request": {
            "name": "Query data from a FAOSTAT domain",
            "description": {
              "content": "Retrieves statistical data records from a specific FAOSTAT domain. Multiple filter values can be comma-separated. Returns JSON or CSV depending on output_type. When no filters are provided, returns all data for the domain (may be large).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":lang",
                "data",
                ":domain"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "area",
                  "value": "<string>",
                  "description": "Comma-separated area codes (country/region codes, e.g. 5 for China). Use dimension endpoint to discover valid codes."
                },
                {
                  "disabled": false,
                  "key": "item",
                  "value": "<string>",
                  "description": "Comma-separated item codes (commodity codes, e.g. 15 for Wheat). Use dimension endpoint to discover valid codes."
                },
                {
                  "disabled": false,
                  "key": "element",
                  "value": "<string>",
                  "description": "Comma-separated element codes (statistical measure codes, e.g. 5510 for Area harvested). Use dimension endpoint to discover valid codes."
                },
                {
                  "disabled": false,
                  "key": "year",
                  "value": "<string>",
                  "description": "Comma-separated year values (e.g. 2020,2021,2022). Supports range notation."
                },
                {
                  "disabled": false,
                  "key": "year_start",
                  "value": "<integer>",
                  "description": "Start year for a date range filter (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "year_end",
                  "value": "<integer>",
                  "description": "End year for a date range filter (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "area_cs",
                  "value": "FAO",
                  "description": "Area code system to use: FAO (default) or ISO2, ISO3, M49."
                },
                {
                  "disabled": false,
                  "key": "item_cs",
                  "value": "FAO",
                  "description": "Item code system to use: FAO (default) or CPC."
                },
                {
                  "disabled": false,
                  "key": "output_type",
                  "value": "objects",
                  "description": "Response format: objects (default, JSON array of objects) or arrays (JSON array of arrays) or csv (CSV text)"
                },
                {
                  "disabled": false,
                  "key": "null_values",
                  "value": "false",
                  "description": "Include null/missing values in the response (true or false)."
                },
                {
                  "disabled": false,
                  "key": "show_codes",
                  "value": "true",
                  "description": "Include dimension codes alongside labels in response (true or false)."
                },
                {
                  "disabled": false,
                  "key": "show_unit",
                  "value": "true",
                  "description": "Include unit of measurement in response (true or false)."
                },
                {
                  "disabled": false,
                  "key": "show_flags",
                  "value": "true",
                  "description": "Include data quality flags in response (true or false)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "en",
                  "key": "lang",
                  "description": "(Required) Response language code (en=English, es=Spanish, fr=French, ar=Arabic, zh=Chinese, ru=Russian)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "domain",
                  "description": "(Required) FAOSTAT domain code (e.g. QCL for Crops and livestock products, TM for Trade, RL for Land Use)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
