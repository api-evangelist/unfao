  "info": {
    "_postman_id": "39c58a0c-60f7-4d4e-ad4c-80a61228986f",
    "name": "FAOSTAT Bulk Download Catalog Metadata API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The FAOSTAT Bulk Download API enables retrieval of complete FAOSTAT datasets as compressed CSV archives. Users can browse the dataset catalog to discover available datasets for any FAOSTAT domain, along with last-updated dates and direct download URLs for the zipped CSV files. No authentication is required.\n\nContact Support:\n Name: FAOSTAT Support\n Email: faostat@fao.org",
      "type": "text/plain"
    }
  }
