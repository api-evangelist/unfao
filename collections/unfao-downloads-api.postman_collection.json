            "name": "Download a bulk dataset ZIP file",
            "description": {
              "content": "Downloads a complete FAOSTAT dataset as a compressed ZIP file containing one or more CSV files. Filenames are obtained from the catalog endpoint. Files may be several hundred megabytes for large domains.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":filename"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "filename",
                  "description": "(Required) ZIP filename as listed in the catalog (e.g. Production_Crops_Livestock_E_All_Data_NOFLAG.zip)"
                }
              ]
            },
            "header": [
